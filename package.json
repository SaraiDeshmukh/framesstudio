{
  "name": "framesstudio",
  "private": true,
  "description": "Frame Try-On Studio: multi-retailer eyewear try-on platform (static site + Firebase). The site itself needs no build; these packages are only for tests and deploying rules.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project demo-frame-studio \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "serve": "python3 -m http.server 8000",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.33.0"
  },
  "engines": { "node": ">=20" }
}
